{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "package.json",
      "package-lock.json",
      "playwright.config.js",
      "_config.yml",
      "**/.*",
      "**/node_modules/**",
      "*.md",
      "*.log",
      "tests/**",
      "playwright-report/**",
      "test-results/**",
      "scripts/import-firestore.html",
      "scripts/*.mjs",
      "scripts/*.ps1"
    ]
  }
}
