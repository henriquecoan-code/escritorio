rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userEmail() {
      return signedIn() && request.auth.token.email != null ? request.auth.token.email.lower() : '';
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/meta/security)
        && (
          (
            'adminUids' in get(/databases/$(database)/documents/meta/security).data
            && request.auth.uid in get(/databases/$(database)/documents/meta/security).data.adminUids
          ) || (
            'adminEmails' in get(/databases/$(database)/documents/meta/security).data
            && userEmail() in get(/databases/$(database)/documents/meta/security).data.adminEmails
          )
        );
    }

    function canAccess(panel) {
      return isAdmin()
        || (signedIn()
          && userEmail() != ''
          && exists(/databases/$(database)/documents/admin_users/$(userEmail()))
          && get(/databases/$(database)/documents/admin_users/$(userEmail())).data.active == true
          && get(/databases/$(database)/documents/admin_users/$(userEmail())).data.panels[panel] == true);
    }

    // Campos permitidos no schema de contratos (v2 - adicionados campos de etapa e datas)
    function validContrato(data) {
      return data.keys().hasOnly([
        'uid','numero','data','cliente','mes','area','acao','tipo','origem','adv','status','obs',
        'etapa','dtChegada','dtContato','dtEnvioContrato','dtAssinatura',
        'dtDocs','dtDocsRec','dtEntrega','docsPendentes','createdAt','updatedAt'
      ]);
    }

    match /contratos/{docId} {
      allow read:   if canAccess('dashboard');
      allow create: if canAccess('dashboard') && validContrato(request.resource.data);
      allow update: if canAccess('dashboard');
      allow delete: if canAccess('dashboard');
    }

    match /relacionamento_clientes/{docId} {
      allow read, write: if canAccess('relacionamento');
    }

    match /relacionamento_interacoes/{docId} {
      allow read, write: if canAccess('relacionamento');
    }

    match /meta/relacionamento_config {
      allow read, write: if canAccess('relacionamento');
    }

    match /cobranca_propria_vista/{docId} {
      allow read, write: if canAccess('financeiro');
    }

    match /cobranca_propria_parc/{docId} {
      allow read, write: if canAccess('financeiro');
    }

    match /cobranca_clientes_vista/{docId} {
      allow read, write: if canAccess('financeiro');
    }

    match /cobranca_clientes_parc/{docId} {
      allow read, write: if canAccess('financeiro');
    }

    match /cobranca_acordos/{docId} {
      allow read, write: if canAccess('financeiro');
    }

    match /cobranca_judicial/{docId} {
      allow read, write: if canAccess('financeiro');
    }

    match /meta/cobranca_config {
      allow read, write: if canAccess('financeiro');
    }

    match /meta/{docId} {
      allow read, write: if docId != 'security' && canAccess('dashboard');
    }

    match /meta/security {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /admin_users/{uid} {
      allow read, write: if isAdmin();
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
